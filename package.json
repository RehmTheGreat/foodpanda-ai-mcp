{
  "name": "foodpanda-ai-mcp",
  "version": "0.3.0",
  "description": "Unofficial MCP server for foodpanda / Delivery Hero public discovery data — search restaurants, menus, fees and deals across 10 markets. Read-only, no API key, no account, no ordering.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "foodpanda",
    "delivery-hero",
    "food-delivery",
    "restaurants",
    "claude",
    "llm",
    "ai",
    "anthropic",
    "mcp-server"
  ],
  "homepage": "https://github.com/RehmTheGreat/foodpanda-ai-mcp#readme",
  "bugs": {
    "url": "https://github.com/RehmTheGreat/foodpanda-ai-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RehmTheGreat/foodpanda-ai-mcp.git"
  },
  "license": "MIT",
  "author": "RehmTheGreat",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "foodpanda-ai-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-executable.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "smoke": "node scripts/smoke-stdio.js",
    "smoke:http": "node scripts/smoke-http.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
