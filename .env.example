# ---------------------------------------------------------------------------
# foodpanda-ai-mcp configuration
#
# EVERY VALUE HERE IS OPTIONAL. The server runs with zero configuration and
# zero API keys. These only tune behaviour.
# ---------------------------------------------------------------------------

# Transport: "stdio" (default, for Claude Desktop / Claude Code / Cursor)
#            "http"  (streamable HTTP, for remote hosting)
MCP_TRANSPORT=stdio

# --- HTTP transport only -----------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Comma-separated allowlist for CORS + DNS-rebinding protection.
# "*" allows any origin (convenient for local dev, not recommended in production).
ALLOWED_ORIGINS=*
# Comma-separated Host header allowlist. Empty disables host checking.
ALLOWED_HOSTS=

# --- Defaults ----------------------------------------------------------------
# Market used when a tool call does not specify one. See docs/API-RESEARCH.md
# for the full supported list (pk, bd, my, sg, ph, tw, hk, kh, la, mm).
FOODPANDA_DEFAULT_MARKET=pk
# Upstream language id. 1 = English on every market tested.
FOODPANDA_LANGUAGE_ID=1

# Ceiling on how many nearby vendors a filtered search may scan.
# This bounds the LISTING host only, which has no page-size cap and is NOT the
# bot-protected one, so a high value is cheap: ~500 vendors is two or three
# requests. It does not affect menu fetches, which stay bounded per tool.
FOODPANDA_MAX_SCAN=600
# Vendors requested per listing page. Upstream honours large values.
FOODPANDA_LISTING_PAGE_SIZE=200

# --- Politeness / resilience -------------------------------------------------
# Sustained upstream requests per second (token bucket). The menu host sits
# behind PerimeterX bot protection and begins returning HTTP 403 challenges when
# one IP gets busy, so these defaults are deliberately low. Raising them makes a
# block MORE likely, not throughput higher.
FOODPANDA_RATE_LIMIT_RPS=2
FOODPANDA_RATE_LIMIT_BURST=4
# Max simultaneous in-flight upstream requests.
FOODPANDA_MAX_CONCURRENCY=2
# Per-request timeout in milliseconds.
FOODPANDA_TIMEOUT_MS=15000
# Retry attempts for retryable failures (429/5xx/network), excluding the first try.
FOODPANDA_MAX_RETRIES=3
# Circuit breaker: consecutive failures before the circuit opens, and how long
# it stays open before a trial request is allowed through.
FOODPANDA_BREAKER_THRESHOLD=5
FOODPANDA_BREAKER_RESET_MS=30000

# --- Cache -------------------------------------------------------------------
# Backend: "memory" (default) or "redis".
CACHE_BACKEND=memory
# Max entries held by the in-memory cache before least-recently-used eviction.
CACHE_MAX_ENTRIES=500
# TTL overrides in seconds. Listings move fast; market config almost never changes.
CACHE_TTL_LISTING_S=120
CACHE_TTL_VENDOR_S=900
CACHE_TTL_CONFIG_S=86400
CACHE_TTL_GEOCODE_S=604800
# Only read when CACHE_BACKEND=redis. The redis client is an optional dependency:
# npm install redis
REDIS_URL=

# --- Logging -----------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
# "json" (default, structured) or "pretty"
LOG_FORMAT=json

# --- Geocoding ---------------------------------------------------------------
# Address -> coordinates uses OpenStreetMap Nominatim, which needs no API key
# but does require a contact-identifying User-Agent per its usage policy.
# Set this to your own contact if you self-host at any volume.
GEOCODER_USER_AGENT=
# Set to "false" to disable address lookup entirely (coordinate-only mode).
GEOCODER_ENABLED=true
